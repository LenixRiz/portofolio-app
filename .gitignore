# ==========================================
# 3. Dynamic User Uploads & Media Assets
# ==========================================
# Abaikan seluruh berkas gambar dan dokumen dinamis hasil upload lokal,
# tetapi pertahankan struktur foldernya melalui file .gitkeep.
backend/**/wwwroot/uploads/*
!backend/**/wwwroot/uploads/.gitkeep

backend/**/wwwroot/docs/*
!backend/**/wwwroot/docs/.gitkeep

